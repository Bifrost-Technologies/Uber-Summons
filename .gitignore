# Source-only repository: allow Lua, manifests, Markdown, build/verification source and metadata.
*
!*/
!*.lua
!*.toc
!*.md
!*.ps1
!*.cjs
!*.bat
!*.cmd
!LICENSE
!.gitignore
!.gitattributes
!.editorconfig

# Generated releases belong in GitHub/CurseForge release uploads, not source commits.
/dist/
/share/
/submission/
/artifacts/
/coverage/
/test-results/
/release/
*.zip
*.7z
*.rar
*.tar
*.gz
*.sha256

# Dependencies, compiled output and editor caches
node_modules/
bin/
obj/
build/
.vs/
.vscode/
.idea/
*.exe
*.dll
*.pdb
*.obj
*.ilk
*.lib
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Credentials/local configuration are not part of these source-only addon repositories.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.kdbx
credentials*.json
client_secret*.json
*.local.json
*.local.ps1

# Game/account data and personal SavedVariables are never source files.
WTF/
SavedVariables/
/Uber.lua
/Tranquility.lua
/TranquilityLFG.lua
/data/
/backups/

# Private workspace projects must not be added to either public repository.
/TitansGuild/
/companion/
/github-ready/
/curseforge/discord-posts/
/guild/README-DISCORD.md
# Public release automation and runtime icon assets
!/.github/workflows/release.yml
!/Uber/.pkgmeta
!/Uber/UberIcon.tga

# Public commit packaging
!/.github/workflows/release.yml
!/scripts/release.py
!/release.json
!*.tga
/dist/
__pycache__/
.env
.env.*
*.exe
*.pdb

!/docs/FEATURE-AUDIT-2026-11-20.json

!/docs/FEATURE-AUDIT-2026-11-20.json
